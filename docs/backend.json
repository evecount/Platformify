
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a platform owner or administrator.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier (Firebase Auth UID)."
        },
        "email": {
          "type": "string",
          "description": "The email address of the user.",
          "format": "email"
        },
        "role": {
          "type": "string",
          "description": "The role of the user (e.g., 'platform_owner', 'super_admin')."
        },
        "ownedPlatformIds": {
          "type": "array",
          "description": "IDs of platforms owned by this user.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "email",
        "role"
      ]
    },
    "Platform": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Platform",
      "type": "object",
      "description": "Represents a white-label booking marketplace instance.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier."
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the owner."
        },
        "name": {
          "type": "string",
          "description": "Display name of the platform."
        },
        "niche": {
          "type": "string",
          "description": "The specific market focus (e.g., 'Bali Villas')."
        },
        "customDomain": {
          "type": "string",
          "description": "Custom domain configured for the platform.",
          "format": "uri"
        },
        "themeConfig": {
          "type": "string",
          "description": "JSON string for colors, logos, etc."
        },
        "status": {
          "type": "string",
          "description": "Current status.",
          "enum": ["active", "suspended"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "name",
        "status"
      ]
    },
    "Listing": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Listing",
      "type": "object",
      "description": "An item or service available for booking.",
      "properties": {
        "id": {
          "type": "string"
        },
        "platformId": {
          "type": "string"
        },
        "ownerId": {
          "type": "string",
          "description": "Denormalized owner UID for authorization."
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "pricePerDay": {
          "type": "number"
        },
        "capacity": {
          "type": "number"
        },
        "imageUrl": {
          "type": "string"
        },
        "amenities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status": {
          "type": "string",
          "enum": ["active", "inactive"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "platformId",
        "ownerId",
        "title",
        "pricePerDay"
      ]
    },
    "Customer": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Customer",
      "type": "object",
      "description": "An end-user of a specific platform.",
      "properties": {
        "id": {
          "type": "string"
        },
        "platformId": {
          "type": "string"
        },
        "ownerId": {
          "type": "string",
          "description": "Denormalized platform owner UID."
        },
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        }
      },
      "required": [
        "id",
        "platformId",
        "ownerId",
        "name",
        "email"
      ]
    },
    "Booking": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Booking",
      "type": "object",
      "description": "A reservation record.",
      "properties": {
        "id": {
          "type": "string"
        },
        "platformId": {
          "type": "string"
        },
        "ownerId": {
          "type": "string",
          "description": "Denormalized platform owner UID."
        },
        "listingId": {
          "type": "string"
        },
        "customerId": {
          "type": "string"
        },
        "startDate": {
          "type": "string",
          "format": "date-time"
        },
        "endDate": {
          "type": "string",
          "format": "date-time"
        },
        "totalPrice": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "completed", "cancelled"]
        }
      },
      "required": [
        "id",
        "platformId",
        "ownerId",
        "listingId",
        "customerId",
        "startDate",
        "endDate",
        "totalPrice",
        "status"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "Global user profiles."
        }
      },
      {
        "path": "/platforms/{platformId}",
        "definition": {
          "entityName": "Platform",
          "schema": {
            "$ref": "#/backend/entities/Platform"
          },
          "description": "Top-level tenant roots."
        }
      },
      {
        "path": "/platforms/{platformId}/listings/{listingId}",
        "definition": {
          "entityName": "Listing",
          "schema": {
            "$ref": "#/backend/entities/Listing"
          },
          "description": "Marketplace listings."
        }
      },
      {
        "path": "/platforms/{platformId}/customers/{customerId}",
        "definition": {
          "entityName": "Customer",
          "schema": {
            "$ref": "#/backend/entities/Customer"
          },
          "description": "Tenant-specific customer profiles."
        }
      },
      {
        "path": "/platforms/{platformId}/bookings/{bookingId}",
        "definition": {
          "entityName": "Booking",
          "schema": {
            "$ref": "#/backend/entities/Booking"
          },
          "description": "Booking records."
        }
      }
    ]
  }
}
