
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Global Platform Owner. Acts as the root for a decentralized multi-tenant booking empire.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["platform_owner", "super_admin"] },
        "ownedPlatformIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "email", "role"]
    },
    "Platform": {
      "title": "Platform",
      "type": "object",
      "description": "A 'Sister' Marketplace. Standardized root for niche-specific booking data.",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "name": { "type": "string" },
        "niche": { "type": "string", "description": "The domain vertical (e.g., 'Villas', 'Florist'). Used by agents for domain-specific context." },
        "customDomain": { "type": "string" },
        "themeConfig": { "type": "string", "description": "JSON serialized branding for visual consistency." },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "name", "status"]
    },
    "Listing": {
      "title": "Listing",
      "type": "object",
      "description": "Standardized unit of inventory. Contains 'baseCost' for margin guard agents.",
      "properties": {
        "id": { "type": "string" },
        "platformId": { "type": "string" },
        "ownerId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "pricePerDay": { "type": "number" },
        "baseCost": { "type": "number", "description": "Raw cost for margin calculation. Agents MUST NOT reveal this to customers." },
        "capacity": { "type": "number" },
        "imageUrl": { "type": "string" },
        "amenities": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "aiMetadata": { 
          "type": "object", 
          "description": "High-dimensional behavioral tags (e.g., 'vibe_index', 'luxury_score') generated by agents." 
        }
      },
      "required": ["id", "platformId", "ownerId", "title", "pricePerDay"]
    },
    "Booking": {
      "title": "Booking",
      "type": "object",
      "description": "A cross-platform 'Purchase Signal' event record.",
      "properties": {
        "id": { "type": "string" },
        "platformId": { "type": "string" },
        "ownerId": { "type": "string" },
        "listingId": { "type": "string" },
        "customerId": { "type": "string" },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "totalPrice": { "type": "number" },
        "calculatedMargin": { "type": "number", "description": "The profit captured. Critical for the global prediction engine." },
        "purchaseContext": { 
          "type": "object", 
          "description": "Behavioral triggers captured by the assistant (e.g., 'intent', 'urgency', 'budget_sensitivity')." 
        },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled"] }
      },
      "required": ["id", "platformId", "listingId", "customerId", "startDate", "endDate", "totalPrice", "status"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/User" },
      "description": "Global profiles."
    },
    "/platforms/{platformId}": {
      "schema": { "$ref": "#/backend/entities/Platform" },
      "description": "Multi-tenant root."
    },
    "/platforms/{platformId}/listings/{listingId}": {
      "schema": { "$ref": "#/backend/entities/Listing" },
      "description": "Standardized listings for prediction."
    },
    "/platforms/{platformId}/bookings/{bookingId}": {
      "schema": { "$ref": "#/backend/entities/Booking" },
      "description": "Behavioral purchase events."
    }
  }
}
