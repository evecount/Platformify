
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a platform owner or administrator.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier (Firebase Auth UID)."
        },
        "email": {
          "type": "string",
          "description": "The email address of the user.",
          "format": "email"
        },
        "role": {
          "type": "string",
          "description": "The role of the user (e.g., 'platform_owner', 'super_admin')."
        },
        "ownedPlatformIds": {
          "type": "array",
          "description": "IDs of platforms owned by this user.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "email",
        "role"
      ]
    },
    "Platform": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Platform",
      "type": "object",
      "description": "Represents a white-label booking marketplace instance.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier."
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the owner."
        },
        "name": {
          "type": "string",
          "description": "Display name of the platform."
        },
        "niche": {
          "type": "string",
          "description": "The specific market focus (e.g., 'Bali Villas')."
        },
        "customDomain": {
          "type": "string",
          "description": "Custom domain configured for the platform.",
          "format": "uri"
        },
        "themeConfig": {
          "type": "string",
          "description": "JSON string for colors, logos, etc."
        },
        "status": {
          "type": "string",
          "description": "Current status.",
          "enum": ["active", "suspended"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "name",
        "status"
      ]
    },
    "Listing": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Listing",
      "type": "object",
      "description": "An item or service available for booking.",
      "properties": {
        "id": { "type": "string" },
        "platformId": { "type": "string" },
        "ownerId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "location": { "type": "string" },
        "pricePerDay": { "type": "number" },
        "baseCost": { "type": "number", "description": "Raw cost for the provider (for margin calculations)." },
        "capacity": { "type": "number" },
        "imageUrl": { "type": "string" },
        "amenities": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "platformId",
        "ownerId",
        "title",
        "pricePerDay"
      ]
    },
    "Customer": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Customer",
      "type": "object",
      "description": "An end-user of a specific platform.",
      "properties": {
        "id": { "type": "string" },
        "platformId": { "type": "string" },
        "ownerId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" }
      },
      "required": [
        "id",
        "platformId",
        "ownerId",
        "name",
        "email"
      ]
    },
    "Booking": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Booking",
      "type": "object",
      "description": "A reservation record.",
      "properties": {
        "id": { "type": "string" },
        "platformId": { "type": "string" },
        "ownerId": { "type": "string" },
        "listingId": { "type": "string" },
        "customerId": { "type": "string" },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "totalPrice": { "type": "number" },
        "calculatedMargin": { "type": "number", "description": "Margin recorded at time of booking." },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled"] }
      },
      "required": [
        "id",
        "platformId",
        "ownerId",
        "listingId",
        "customerId",
        "startDate",
        "endDate",
        "totalPrice",
        "status"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/User" },
      "description": "Global user profiles."
    },
    "/platforms/{platformId}": {
      "schema": { "$ref": "#/backend/entities/Platform" },
      "description": "Top-level tenant roots."
    },
    "/platforms/{platformId}/listings/{listingId}": {
      "schema": { "$ref": "#/backend/entities/Listing" },
      "description": "Marketplace listings."
    },
    "/platforms/{platformId}/customers/{customerId}": {
      "schema": { "$ref": "#/backend/entities/Customer" },
      "description": "Tenant-specific customer profiles."
    },
    "/platforms/{platformId}/bookings/{bookingId}": {
      "schema": { "$ref": "#/backend/entities/Booking" },
      "description": "Booking records."
    }
  }
}
